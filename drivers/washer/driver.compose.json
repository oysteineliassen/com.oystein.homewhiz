{
  "name": {
    "en": "Washing machine",
    "no": "Vaskemaskin"
  },
  "class": "washer",
  "capabilities": [
    "washer_start",
    "washer_pause",
    "washer_state",
    "washer_program",
    "washer_phase",
    "washer_remaining",
    "washer_temperature",
    "washer_spin",
    "washer_door_locked",
    "washer_remote_control",
    "washer_on",
    "homewhiz_connected"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "ble"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "debug_raw",
      "type": "checkbox",
      "label": {
        "en": "Log raw BLE data",
        "no": "Logg rå BLE-data"
      },
      "hint": {
        "en": "Writes every received BLE frame and assembled status message as hex to the app log.",
        "no": "Skriver hver mottatte BLE-ramme og sammensatte statusmelding som hex til app-loggen."
      },
      "value": true
    },
    {
      "id": "ignore_remote_check",
      "type": "checkbox",
      "value": false,
      "label": {
        "en": "Send commands without remote control signal (test)",
        "no": "Send kommandoer uten fjernstyringssignal (test)"
      },
      "hint": {
        "en": "Sends start/pause even when the machine does not report Remote Control as enabled. Only for testing whether the machine accepts commands.",
        "no": "Sender start/pause selv om maskinen ikke melder at Remote Control er på. Bare for å teste om maskinen godtar kommandoer."
      }
    }
  ]
}
