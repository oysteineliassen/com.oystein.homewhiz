{
  "name": {
    "en": "Washing machine",
    "no": "Vaskemaskin"
  },
  "class": "washer",
  "capabilities": [
    "washer_start",
    "washer_pause",
    "washer_state",
    "washer_program_select",
    "washer_phase",
    "washer_remaining",
    "washer_temperature",
    "washer_spin",
    "washer_door_locked",
    "alarm_generic.door_open",
    "alarm_generic.no_water",
    "alarm_generic.security",
    "washer_remote_control",
    "washer_on",
    "homewhiz_connected"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "ble"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "debug_raw",
      "type": "checkbox",
      "label": {
        "en": "Log raw BLE data",
        "no": "Logg rå BLE-data"
      },
      "hint": {
        "en": "Writes every received BLE frame and assembled status message as hex to the app log.",
        "no": "Skriver hver mottatte BLE-ramme og sammensatte statusmelding som hex til app-loggen."
      },
      "value": false
    }
  ],
  "capabilitiesOptions": {
    "alarm_generic.door_open": {
      "title": {
        "en": "Door open",
        "no": "Døren er åpen"
      }
    },
    "alarm_generic.no_water": {
      "title": {
        "en": "No water intake",
        "no": "Tar ikke inn vann"
      }
    },
    "alarm_generic.security": {
      "title": {
        "en": "Safety warning",
        "no": "Sikkerhetsadvarsel"
      }
    }
  }
}
