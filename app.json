      "name": {
        "en": "Washing machine",
        "no": "Vaskemaskin"
      },
      "class": "washer",
      "capabilities": [
        "washer_state",
        "washer_program",
        "washer_phase",
        "washer_remaining",
        "washer_temperature",
        "washer_spin",
        "washer_on",
